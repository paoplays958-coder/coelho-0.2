    end
    if speedEnabled then
        speedEnabled = false
        speedBtn.Text = "Ativar Speed"
        speedBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
    end
    if jumpEnabled then
        jumpEnabled = false
        jumpBtn.Text = "Ativar Jump"
        jumpBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
    end
end)
