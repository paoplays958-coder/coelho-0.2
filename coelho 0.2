-- Sistema de slider para Speed
local speedDragging = false
local speedDragConnection = nil

local function updateSpeedSlider(inputPosition)
    local sliderPos = speedSliderBg.AbsolutePosition
    local sliderSize = speedSliderBg.AbsoluteSize
    
    local relativeX = math.clamp(inputPosition.X - sliderPos.X, 0, sliderSize.X)
    local percent = relativeX / sliderSize.X
    
    speedValue = math.floor(percent * 100)
    speedSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    speedLabel.Text = "Velocidade: " .. speedValue
    
    updateSpeed()
end

speedSliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        speedDragging = true
        
        speedDragConnection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                speedDragging = false
                if speedDragConnection then
                    speedDragConnection:Disconnect()
                    speedDragConnection = nil
                end
            end
        end)
        
        updateSpeedSlider(input.Position)
    end
end)

speedSliderBtn.InputChanged:Connect(function(input)
    if speedDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSpeedSlider(input.Position)
    end
end)

-- Sistema de slider para Jump
local jumpDragging = false
