-- Sistema de slider para Speed
local speedDragging = false
local speedDragConnection = nil

local function updateSpeedSlider(inputPosition)
    local sliderPos = speedSliderBg.AbsolutePosition
    local sliderSize = speedSliderBg.AbsoluteSize
    
    local relativeX = math.clamp(inputPosition.X - sliderPos.X, 0, sliderSize.X)
    local percent = relativeX / sliderSize.X
    
    speedValue = math.floor(percent * 100)
    speedSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    speedLabel.Text = "Velocidade: " .. speedValue
    
    updateSpeed()
end

speedSliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        speedDragging = true
        
        speedDragConnection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                speedDragging = false
                if speedDragConnection then
                    speedDragConnection:Disconnect()
                    speedDragConnection = nil
                end
            end
        end)
        
        updateSpeedSlider(input.Position)
    end
end)

speedSliderBtn.InputChanged:Connect(function(input)
    if speedDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSpeedSlider(input.Position)
    end
end)

-- Sistema de slider para Jump
local jumpDragging = false
local jumpDragConnection = nil

local function updateJumpSlider(inputPosition)
    local sliderPos = jumpSliderBg.AbsolutePosition
    local sliderSize = jumpSliderBg.AbsoluteSize
    
    local relativeX = math.clamp(inputPosition.X - sliderPos.X, 0, sliderSize.X)
    local percent = relativeX / sliderSize.X
    
    jumpValue = math.floor(percent * 200)
    jumpSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    jumpLabel.Text = "Força do Pulo: " .. jumpValue
    
    updateJump()
end

jumpSliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        jumpDragging = true
        
        jumpDragConnection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                jumpDragging = false
                if jumpDragConnection then
                    jumpDragConnection:Disconnect()
                    jumpDragConnection = nil
                end
            end
        end)
        
        updateJumpSlider(input.Position)
    end
end)

jumpSliderBtn.InputChanged:Connect(function(input)
    if jumpDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateJumpSlider(input.Position)
    end
end)

-- Evento botão Speed
speedBtn.MouseButton1Click:Connect(function()
    if not keyValidated then return end
    
    speedEnabled = not speedEnabled
    
    if speedEnabled then
        speedBtn.Text = "Desativar Speed"
        speedBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        humanoid.WalkSpeed = speedValue
    else
        speedBtn.Text = "Ativar Speed"
        speedBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        humanoid.WalkSpeed = 16
    end
end)

-- Evento botão Jump
jumpBtn.MouseButton1Click:Connect(function()
    if not keyValidated then return end
    
    jumpEnabled = not jumpEnabled
    
    if jumpEnabled then
        jumpBtn.Text = "Desativar Jump"
        jumpBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        humanoid.JumpPower = jumpValue
    else
        jumpBtn.Text = "Ativar Jump"
        jumpBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        humanoid.JumpPower = 50
    end
end)

-- Sistema de arrastar janela melhorado
local function updateDrag(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        dragInput = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingWindow = false
                if dragInput then
                    dragInput:Disconnect()
                    dragInput = nil
                end
            end
        end)
    end
end)

title.InputChanged:Connect(function(input)
    if draggingWindow and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

-- Evento botão Minimizar
minimizeBtn.MouseButton1Click:Connect(function()
    if not keyValidated then return end
    
    isMinimizing = true
    minimized = not minimized
    
    if minimized then
        tabContainer.Visible = false
        contentContainer.Visible = false
        
        mainFrame:TweenSize(
            UDim2.new(0, 400, 0, 50),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.3,
            true,
            function()
                isMinimizing = false
            end
        )
        minimizeBtn.Text = "□"
    else
        mainFrame:TweenSize(
            UDim2.new(0, 400, 0, 450),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.3,
            true,
            function()
                tabContainer.Visible = true
                contentContainer.Visible = true
                isMinimizing = false
            end
        )
        minimizeBtn.Text = "−"
    end
end)

-- Evento botão Fechar
closeBtn.MouseButton1Click:Connect(function()
    if not keyValidated then return end
    
    if flyEnabled then
        stopFly()
    end
    screenGui:Destroy()
end)

-- Sistema de Verificação de Key
verifyKeyBtn.MouseButton1Click:Connect(function()
    local enteredKey = keyTextBox.Text
    
    if isValidKey(enteredKey) then
        keyValidated = true
        keyStatusLabel.Text = "✓ Key válida! Carregando Dragon Hub..."
        keyStatusLabel.TextColor3 = Color3.fromRGB(50, 200, 100)
        verifyKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        verifyKeyBtn.Text = "✓ Acesso Liberado!"
        
        wait(1.5)
        
        keyFrame:TweenPosition(
            UDim2.new(0.5, -200, -0.5, 0),
            Enum.EasingDirection.In,
            Enum.EasingStyle.Back,
            0.5,
            true,
            function()
                keyFrame:Destroy()
                mainFrame.Visible = true
                mainFrame:TweenPosition(
                    UDim2.new(0.5, -200, 0.5, -225),
                    Enum.EasingDirection.Out,
                    Enum.EasingStyle.Back,
                    0.5,
                    true
                )
            end
        )
    else
        keyStatusLabel.Text = "✗ Key inválida! Obtenha uma key válida."
        keyStatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        verifyKeyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        verifyKeyBtn.Text = "✗ Key Incorreta"
        
        -- Efeito de shake
        for i = 1, 3 do
            keyFrame.Position = keyFrame.Position + UDim2.new(0, 10, 0, 0)
            wait(0.05)
            keyFrame.Position = keyFrame.Position - UDim2.new(0, 20, 0, 0)
            wait(0.05)
            keyFrame.Position = keyFrame.Position + UDim2.new(0, 10, 0, 0)
            wait(0.05)
        end
        
        keyTextBox.Text = ""
        
        wait(1)
        
        verifyKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        verifyKeyBtn.Text = "✓ Verificar Key"
        keyStatusLabel.Text = "Dragon Hub v0.2"
        keyStatusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    end
end)

